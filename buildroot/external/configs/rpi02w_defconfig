BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_VFPV4=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-zero-2-w"
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_arm64"

# Pi mode prerequisites (see docs/source-mode-design.md, S1)
# Kernel fragment for the V4L2 codec, ALSA loopback, uinput and vc4 KMS
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AA_PROXY_OS_PATH)/board/common/kernel.config $(BR2_EXTERNAL_AA_PROXY_OS_PATH)/board/rpi/kernel-source-mode.config"
# Tools used by board/rpi/scripts/source-spike.sh
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
# Install /usr/bin/source-spike.sh (replaces the post-build script from common_rpi.part, so keep both)
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AA_PROXY_OS_PATH)/board/rpi/post-build.sh $(BR2_EXTERNAL_AA_PROXY_OS_PATH)/board/rpi/scripts/install-source-spike.sh"
