# Kernel additions for Pi mode (source mode), rpi02w only.
# Applied after board/common/kernel.config, so these override its "=n" lines.
# Kernel: raspberrypi/linux 6.12.

# V4L2 mem2mem and the VideoCore H.264 codec (bcm2835-codec, /dev/video10-12)
CONFIG_STAGING=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_BCM_VIDEOCORE=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_VCHIQ_CDEV=y
CONFIG_VIDEO_CODEC_BCM2835=y

# ALSA loopback for Kodi audio capture
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_ALOOP=y

# Virtual touch input (uinput) and evdev
CONFIG_INPUT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y

# vc4 KMS (DRM), to look for a writeback connector
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_VC4_HDMI_CEC=n
